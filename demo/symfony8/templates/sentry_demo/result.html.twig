{% extends 'base.html.twig' %}

{% block title %}{{ use_case }}{% endblock %}

{% block nowo_ui_page_header %}
    <div class="nowo-ui-page-header">
        <h1 class="nowo-ui-page-header__title">{{ title }}</h1>
        <span class="nowo-ui-badge nowo-ui-badge--info" data-testid="demo-use-case">{{ use_case }}</span>
    </div>
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <p>{{ message }}</p>
            <div class="nowo-ui-flash nowo-ui-flash--info" role="status">
                <strong>Dónde ver el resultado:</strong> revisa los <strong>logs</strong> de la aplicación (<code class="nowo-ui-code">var/log/</code> o <code class="nowo-ui-code">docker-compose logs -f php</code>) y, si tienes <code class="nowo-ui-code">SENTRY_DSN</code> configurado, el proyecto en <strong>Sentry</strong>.
            </div>
            <a href="{{ path('sentry_demo_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Volver al índice de rutas</a>
        </div>
    </section>
{% endblock %}
