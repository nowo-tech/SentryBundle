{% extends 'base.html.twig' %}

{% block title %}{{ use_case }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: title,
        toolbar: '<a href="' ~ path('sentry_demo_index') ~ '" class="nowo-ui-btn nowo-ui-btn--outline">← Volver al índice de rutas</a>',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Resultado', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info" data-testid="demo-use-case">{{ use_case }}</span>{% endblock %}
        {% block section_body %}
            <p>{{ message }}</p>
            <p><strong>Dónde ver el resultado:</strong> revisa los <strong>logs</strong> de la aplicación (<code class="nowo-ui-code">var/log/</code> o <code class="nowo-ui-code">docker-compose logs -f php</code>) y, si tienes <code class="nowo-ui-code">SENTRY_DSN</code> configurado, el proyecto en <strong>Sentry</strong>.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
