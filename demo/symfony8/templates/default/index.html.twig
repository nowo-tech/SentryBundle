{% extends 'base.html.twig' %}

{% block title %}Inicio{% endblock %}

{% block nowo_ui_page_header %}
    <div class="nowo-ui-page-header">
        <h1 class="nowo-ui-page-header__title">{{ message }}</h1>
    </div>
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <p>Si ves esta página, el demo está funcionando correctamente.</p>
            <p>La barra del Web Profiler aparece abajo cuando <code class="nowo-ui-code">APP_DEBUG=1</code>.</p>
            <a href="{{ path('sentry_demo_index') }}" class="nowo-ui-btn nowo-ui-btn--primary">Ver rutas de demo del Sentry Bundle</a>
        </div>
    </section>
{% endblock %}
