{% extends 'base.html.twig' %}

{% block title %}Inicio{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: message,
        intro: 'Si ves esta página, el demo está funcionando correctamente.',
        toolbar: '<a href="' ~ path('sentry_demo_index') ~ '" class="nowo-ui-btn nowo-ui-btn--primary">Ver rutas de demo del Sentry Bundle</a>',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Web Profiler', kind: 'detail'} %}
        {% block section_body %}
            <p>La barra del Web Profiler aparece abajo cuando <code class="nowo-ui-code">APP_DEBUG=1</code>.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
