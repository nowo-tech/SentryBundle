# PHPStan configuration for Sentry Bundle.
#
# Static analysis on src/ and tests/ (level 8). Run: make phpstan
parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - demo/*
        - vendor/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
